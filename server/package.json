{
  "name": "campusconnect-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "seed": "node --env-file-if-exists=.env src/seed.ts",
    "demo:no-lock": "node --env-file-if-exists=.env src/demo-no-lock.ts",
    "test": "vitest run --config vitest.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate --config prisma7.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "express": "latest",
    "express-rate-limit": "^8.7.5",
    "file-type": "^22.3.0",
    "helmet": "latest",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "latest",
    "prisma": "7.10.1",
    "supertest": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
