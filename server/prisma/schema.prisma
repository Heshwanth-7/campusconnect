generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  email                   String                   @unique
  passwordHash            String
  role                    Role                     @default(STUDENT)
  emailVerifiedAt         DateTime?
  failedLoginCount        Int                      @default(0)
  lockedUntil             DateTime?
  blockedAt               DateTime?
  createdAt               DateTime                 @default(now())
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  events                  Event[]
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  tokenHash    String         @unique @db.Char(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?        @unique @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken?  @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken?  @relation("RefreshRotation")

  @@index([userId])
}

enum EventCategory {
  MUSIC
  TECH
  SPORTS
  CULTURAL
  WORKSHOP
  OTHER
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

model Event {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  description     String
  category        EventCategory
  tags            String[]
  venue           String
  startsAt        DateTime      @db.Timestamptz(3)
  endsAt          DateTime      @db.Timestamptz(3)
  capacity        Int
  status          EventStatus   @default(PENDING)
  rejectionReason String?
  clubName        String
  organizerId     String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  organizer       User          @relation(fields: [organizerId], references: [id])

  @@index([status])
  @@index([startsAt])
  @@index([category])
  @@index([organizerId])
}
