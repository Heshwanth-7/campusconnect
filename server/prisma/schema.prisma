generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ORGANIZER
  ADMIN
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  email                   String                   @unique
  passwordHash            String
  role                    Role                     @default(STUDENT)
  emailVerifiedAt         DateTime?
  interests               String[]                 @default([])
  interestsOnboarded      Boolean                  @default(false)
  failedLoginCount        Int                      @default(0)
  lockedUntil             DateTime?
  blockedAt               DateTime?
  createdAt               DateTime                 @default(now())
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  lostFoundPosts          LostFoundPost[]
  events                  Event[]
  notifications           Notification[]
  registrations           Registration[]
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  tokenHash    String         @unique @db.Char(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?        @unique @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   RefreshToken?  @relation("RefreshRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken?  @relation("RefreshRotation")

  @@index([userId])
}

enum EventCategory {
  MUSIC
  TECH
  SPORTS
  CULTURAL
  WORKSHOP
  OTHER
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

model Event {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  description     String
  category        EventCategory
  tags            String[]
  venue           String
  posterImagePath String?
  registrationDeadline DateTime? @db.Timestamptz(3)
  startsAt        DateTime      @db.Timestamptz(3)
  endsAt          DateTime      @db.Timestamptz(3)
  capacity        Int
  status          EventStatus   @default(PENDING)
  rejectionReason String?
  clubName        String
  organizerId     String        @db.Uuid
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)
  organizer       User          @relation(fields: [organizerId], references: [id])

  registrations   Registration[]

  @@index([status])
  @@index([startsAt])
  @@index([category])
  @@index([organizerId])
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

model Registration {
  id          String             @id @default(uuid()) @db.Uuid
  userId      String             @db.Uuid
  eventId     String             @db.Uuid
  status      RegistrationStatus
  reminderSentAt DateTime?         @db.Timestamptz(3)
  qrNonce     String?            @db.Uuid
  checkedInAt DateTime?          @db.Timestamptz(3)
  queuedAt    DateTime           @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  cancelledAt DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, status, queuedAt, id])
}

enum PostType {
  LOST
  FOUND
}

enum ItemCategory {
  BOTTLE
  BAG
  ID_CARD
  ELECTRONICS
  BOOK
  CLOTHING
  KEYS
  OTHER
}

enum PostStatus {
  OPEN
  MATCHED
  RESOLVED
}

enum MatchStatus {
  SUGGESTED
  CONFIRMED
  DISMISSED
}

model LostFoundPost {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         PostType
  title        String
  description  String
  category     ItemCategory
  color        String
  location     String
  occurredAt   DateTime      @db.Date
  imagePath    String?
  status       PostStatus    @default(OPEN)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  lostMatches  Match[]       @relation("LostSide")
  foundMatches Match[]       @relation("FoundSide")

  @@index([type, status, category, occurredAt])
  @@index([userId, createdAt])
}

model Match {
  id                   String        @id @default(uuid()) @db.Uuid
  lostPostId           String        @db.Uuid
  foundPostId          String        @db.Uuid
  lostPost             LostFoundPost @relation("LostSide", fields: [lostPostId], references: [id], onDelete: Cascade)
  foundPost            LostFoundPost @relation("FoundSide", fields: [foundPostId], references: [id], onDelete: Cascade)
  score                Int
  status               MatchStatus   @default(SUGGESTED)
  lostUserConfirmedAt  DateTime?     @db.Timestamptz(3)
  foundUserConfirmedAt DateTime?     @db.Timestamptz(3)
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([lostPostId, foundPostId])
  @@index([foundPostId])
}

enum NotificationType {
  SEAT_CONFIRMED
  WAITLIST_PROMOTED
  EVENT_REMINDER
  MATCH_FOUND
  MATCH_CONFIRMED
  EVENT_APPROVED
  EVENT_REJECTED
}

model Notification {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  type            NotificationType
  title           String
  message         String
  linkPath        String
  readAt          DateTime?        @db.Timestamptz(3)
  emailSentAt     DateTime?        @db.Timestamptz(3)
  emailLeaseUntil DateTime?        @db.Timestamptz(3)
  emailAttempts   Int              @default(0)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([userId, readAt])
  @@index([emailSentAt, emailAttempts])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  action     String
  targetType String
  targetId   String   @db.Uuid
  metadata   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([actorId, createdAt, id])
  @@index([action, createdAt, id])
}
